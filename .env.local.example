# Copy this file to .env.local and fill in real values before running `npm run dev`

# Base URL of the NestJS backend, WITHOUT a trailing slash, including the /api prefix
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Socket.io server URL, WITHOUT the /api prefix and WITHOUT a trailing slash
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# reCAPTCHA SITE key (the public one) from https://www.google.com/recaptcha/admin
# Used by the admin Create User form. The matching SECRET key belongs in the
# backend's .env and must never be set here — anything NEXT_PUBLIC_* ships to
# the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

